# =============================================================================
# Mago Agent Platform Environment Configuration
# =============================================================================

# ---- App ----
APP_ENV=development
ENVIRONMENT=development
APP_VERSION=0.1.0
DEBUG=true
# Frontend-only offline demo; keep false for real API integration.
NEXT_PUBLIC_DEMO_MODE=false

# ---- LLM API Keys ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---- PostgreSQL ----
POSTGRES_USER=mago
POSTGRES_PASSWORD=mago_secret
# Optional percent-encoded password for Agent/Goose URL DSNs; set when the raw password contains URL-reserved characters.
POSTGRES_PASSWORD_URLENCODED=
POSTGRES_DB=mago
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_DSN=host=localhost port=5432 user=mago password=mago_secret dbname=mago sslmode=disable
# Python Agent URL DSN; percent-encode the password component if it contains URL-reserved characters.
DATABASE_URL=postgresql://mago:mago_secret@localhost:5432/mago

# ---- Redis ----
# Local host development is passwordless. REDIS_URL is used by the native
# Python Agent process; Docker Compose uses AGENT_REDIS_URL instead because
# localhost inside a container is the container itself.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
AGENT_REDIS_URL=redis://redis:6379/0

# ---- HITL checkpoint store ----
# LangGraph persists paused human-in-the-loop runs here so they survive a
# restart or a second API replica. Leave both blank to use an in-process
# MemorySaver, which is fine for local dev but loses paused runs on exit.
# Resolution order: CHECKPOINTER_URL (postgresql:// or redis://) then
# AGENT_CHECKPOINT_PATH (SQLite file). Install the matching extra:
#   pip install -e ".[checkpoint-postgres]" | ".[checkpoint-redis]" | ".[checkpoint-sqlite]"
CHECKPOINTER_URL=
AGENT_CHECKPOINT_PATH=

# ---- MinIO ----
MINIO_ROOT_USER=mago
MINIO_ROOT_PASSWORD=mago_secret123
# Native API/Agent launches accept MINIO_ACCESS_KEY/SECRET_KEY; keep these
# aligned with the MinIO root credentials used by the local Compose service.
MINIO_ACCESS_KEY=mago
MINIO_SECRET_KEY=mago_secret123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=mago

# ---- JWT ----
# Use the same secret in Go API and Agent; production requires >=32 random characters.
AGENT_AUTH_ENABLED=false
JWT_SECRET=change_this_to_a_secure_random_string_in_production
# Go API token lifetimes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---- Trend crawler ----
CRAWL_USE_SAMPLE_DATA=false
# Maximum time for the dashboard trend-insights request; queued crawls are unaffected.
TREND_INSIGHTS_TIMEOUT_SECONDS=15
DOUYIN_COOKIE=

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:80,http://127.0.0.1:80

# ---- Production-only secrets ----
# Required by docker-compose.prod.yml; leave empty for local development.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ---- Langfuse LLM Observability (08) ----
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- OpenTelemetry (08) ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mago-agent

# ---- Mago Platform Integration (08) ----
MAGO_API_URL=http://localhost:8080
MAGO_API_KEY=
MAGO_SSO_ENABLED=false

# ---- Backup ----
BACKUP_RETENTION_DAYS=30
BACKUP_S3_PATH=
